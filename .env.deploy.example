# ===== Update Agent（scripts/update-agent.js）=====
UPDATE_TOKEN=change-me-to-long-random
GITHUB_REPO=moon-stack-OAo/dev-tools
GITHUB_BRANCH=main
# static | docker
DEPLOY_MODE=static
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3930

# ----- static：只部署 dist（从 CI Release 下载，无需 Node/clone）-----
SITE_ROOT=/var/www/dev-tools
DIST_RELEASE_TAG=latest-dist
DIST_ASSET_NAME=dev-tools-dist.tar.gz
# 可选：覆盖下载 URL（对象存储等）
# DIST_DOWNLOAD_URL=https://example.com/dev-tools-dist.tar.gz

# ----- docker：只 pull 镜像（无需 clone/npm）-----
DOCKER_IMAGE=ghcr.io/moon-stack-OAo/dev-tools
DOCKER_TAG=main
DOCKER_CONTAINER=dev-tools
DOCKER_HOST_PORT=8080
# 私有 GHCR 时：
# GHCR_USER=your-github-username
# GHCR_TOKEN=ghp_xxx

# 兼容旧变量（本地源码构建模式已废弃，可忽略）
# REPO_DIR=/opt/dev-tools/repo
