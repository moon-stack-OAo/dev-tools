# 同源 CORS 代理：绕过浏览器跨域（HTTP 调试 / 视频调试 M3U·HLS）
#
# 架构：
#   浏览器 ──► Nginx
#                ├─ /__cors_proxy  → 127.0.0.1:3927  （node scripts/cors-proxy-server.js）
#                └─ /              → 静态 dist
#
# 启动代理（systemd 或 screen）：
#   CORS_PROXY_HOST=127.0.0.1 CORS_PROXY_PORT=3927 node scripts/cors-proxy-server.js
#
# 校验：
#   curl -sI "https://你的域名/__cors_proxy" | grep -i x-proxied-by
#   应出现：x-proxied-by: dev-tools-cors-proxy
#   且 Content-Type 为 text/plain（缺 target 时 400），绝不能是 text/html（那是 SPA 回退）
#
# 安全：代理等同受限开放转发，请仅反代到 127.0.0.1，勿把 3927 端口直接暴露公网。

# 必须写在 location / 的 try_files 之前，否则会被回退成 index.html
location = /__cors_proxy {
    proxy_pass http://127.0.0.1:3927;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass_request_headers on;
    proxy_pass_request_body on;
    proxy_buffering off;
    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    add_header Cache-Control "no-store" always;
}

# 可选健康检查（代理根路径 /healthz）
location = /__cors_proxy/healthz {
    proxy_pass http://127.0.0.1:3927/healthz;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
}
